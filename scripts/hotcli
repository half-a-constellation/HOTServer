#!/usr/bin/env bash
# hotcli <command...>   e.g. hotcli status | hotcli set name My Room | hotcli players | hotcli start
APPID=3707400
LAUNCH_ARGS="-batchmode -nographics" # Required for headless
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PATHS_FILE="$DIR/../hotserver.paths"   # remembers which BepInEx folder HOTServer is installed in (written by hotcli setup)
TAGS="focus mature chill break modded"

HELP="hotcli commands:
  start                                  Start the server
  stop                                   Stop the server
  reboot | restart                       Restart the server
  start hotwatch | stop hotwatch         Run hotwatch in the background (crash restart, scheduled reboots)
  setup                                  Find where HOTServer is installed (runs automatically the first time)
  status                                 Lobby ID, player count, lobby name, next reboot
  players                                Everyone in the lobby
  config                                 Current lobby settings
  set name <text>                        Lobby name
  set maxplayers <number>                Player limit
  set public|voice|request true|false    Visibility / voice chat / request to join
  set reboot <HH:MM|off>                 Daily reboot time (24h), or off
  tag add|remove <tag>                   Tags: focus, mature, chill, break, modded
"

server_running() { pgrep -f 'OnTogether\.exe.*-batchmode' >/dev/null; }   # our headless instance
game_running()   { pgrep -f 'OnTogether\.exe' >/dev/null; }                # any instance, incl. normal play
watch_running()  { pgrep -f -- "$DIR/hotwatch" >/dev/null; }
# Mod manager profile (r2modman, Gale): BepInEx isn't in the game folder, so point the game at the profile
is_profile() { [[ ! -f "$ROOT/../OnTogether.exe" ]]; }
launch()  {
  local args=($LAUNCH_ARGS)
  is_profile && args+=(--doorstop-enabled true --doorstop-target-assembly "Z:$ROOT/core/BepInEx.Preloader.dll")
  DISPLAY="${DISPLAY:-:1}" steam -applaunch "$APPID" "${args[@]}" >/dev/null 2>&1 & disown
}
die()     { echo "$*" >&2; exit 1; }

# Send the command to the running server and print its reply
send() {
  printf '%s\n' "$*" >&3
  while IFS= read -r -t 10 line <&3; do
    [[ "$line" == "." ]] && break
    printf '%s\n' "$line"
  done
  exec 3>&-
}

# Offline-able commands
truthy()   { [[ "${1,,}" =~ ^(1|true|yes|on|t)$ ]] && echo true || echo false; }
need_cfg() { [[ -f "$CFG" ]] || die "Config not found: $CFG (launch the game once first)"; }
cfg_get()  { sed -n "s/^$1 = //p" "$CFG" | head -1 | tr -d '\r'; }
cfg_set()  {
  awk -v k="$1" -v v="$2" 'index($0, k " = ") == 1 { cr = sub(/\r$/, ""); print k " = " v (cr ? "\r" : ""); next } { print }' "$CFG" > "$CFG.tmp" \
    && mv "$CFG.tmp" "$CFG"
}
# Every HOTServer.dll under the Steam game folders and mod manager profiles -> its BepInEx folder
find_installs() {
  local bases=() vdf lib b
  for vdf in "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" "$HOME/.steam/steam/steamapps/libraryfolders.vdf" \
             "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/libraryfolders.vdf"; do
    [[ -f "$vdf" ]] || continue
    while read -r lib; do bases+=("$lib/steamapps/common/On-Together/On-Together/BepInEx"); done \
      < <(sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)".*/\1/p' "$vdf")
  done
  bases+=("$HOME/.config/r2modmanPlus-local" "$HOME/.var/app/com.github.ebkr.r2modmanPlus/config/r2modmanPlus-local"
          "$HOME/.local/share/com.kesomannen.gale")
  for b in "${bases[@]}"; do
    [[ -d "$b" ]] && find "$b/" -maxdepth 9 -type f -name HOTServer.dll -path '*/BepInEx/plugins/*' 2>/dev/null
  done | sed 's|/BepInEx/plugins/.*|/BepInEx|' | while read -r p; do readlink -f "$p"; done | sort -u
}

setup() {
  local found=() root="" ans i
  mapfile -t found < <(find_installs)
  if (( ${#found[@]} == 1 )); then
    read -rp "Found HOTServer in ${found[0]}. Use this? [Y/n] " ans
    [[ "${ans,,}" == n* ]] || root="${found[0]}"
  elif (( ${#found[@]} > 1 )); then
    echo "Found HOTServer in several places:"
    for i in "${!found[@]}"; do echo "  $((i + 1))) ${found[$i]}"; done
    read -rp "Pick one [1-${#found[@]}]: " ans
    [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#found[@]} )) && root="${found[$((ans - 1))]}"
  fi
  if [[ -z "$root" ]]; then
    read -rp "Enter the BepInEx folder HOTServer is installed in (e.g. .../On-Together/BepInEx): " root
    root="${root/#\~/$HOME}"
  fi
  root="${root%/}"
  [[ -d "$root/plugins" ]] || die "Not a BepInEx folder: $root"
  echo "BEPINEX=$root" > "$PATHS_FILE" || die "Couldn't write $PATHS_FILE"
  ROOT="$root"
  echo "Saved to $(readlink -f "$PATHS_FILE"). Run 'hotcli setup' to change it."
}

case "${1:-help}" in help|-h|--help) echo "$HELP"; exit 0 ;; esac
[[ "$1" == setup ]] && { setup; exit 0; }

ROOT="$(sed -n 's/^BEPINEX=//p' "$PATHS_FILE" 2>/dev/null)"
if [[ -z "$ROOT" ]]; then
  [[ -t 0 ]] || die "HOTServer location unknown. Run: hotcli setup"
  setup
fi
CFG="$ROOT/config/awe.hotserver.cfg"
FLAG="$ROOT/hotserver.stopped"   # tells hotwatch that we stopped on purpose so it doesnt try to restart thinking it was a crash
WATCH_LOG="$ROOT/hotwatch.log"
PORT="$(cfg_get Port 2>/dev/null)"; PORT="${PORT:-27555}"
[[ "$1" == restart ]] && set -- reboot "${@:2}"

# hotwatch runs on its own, whether the server is up or not
if [[ "${2,,}" == hotwatch ]]; then
  case "$1" in
    start)
      watch_running && die "hotwatch is already running"
      setsid -f bash "$DIR/hotwatch" >> "$WATCH_LOG" 2>&1 < /dev/null
      echo "hotwatch started (log: $WATCH_LOG)"
      ;;
    stop)
      watch_running || die "hotwatch isn't running"
      pkill -f -- "$DIR/hotwatch"
      echo "hotwatch stopped"
      ;;
    *) die "usage: hotcli start hotwatch | hotcli stop hotwatch" ;;
  esac
  exit 0
fi

if { exec 3<>"/dev/tcp/127.0.0.1/$PORT"; } 2>/dev/null; then
  if [[ "$1" == reboot ]]; then
    send reboot >/dev/null
    for _ in $(seq 60); do server_running || break; sleep 1; done
    launch
    echo "Rebooting HOTServer"
    exit 0
  fi
  send "$@"
  [[ "$1" == status ]] && { watch_running && echo "hotwatch=running" || echo "hotwatch=off"; }
  exit 0
fi

if server_running; then
  die "The game is running but HOTServer isn't answering yet (still starting, or the config has Enabled = false). Try again in a moment."
fi

case "$1" in
  start)
    game_running && die "On-Together is open normally. Close it first, then: hotcli start"
    launch
    echo "Starting server HOTServer"
    ;;

  stop)
    touch "$FLAG"
    echo "HOTServer already stopped"
    ;;

  config)
    need_cfg
    echo "name=\"$(cfg_get Name)\" maxplayers=$(cfg_get MaxPlayers) public=$(cfg_get Public) voice=$(cfg_get VoiceChat) request=$(cfg_get RequestToJoin) tags=$(cfg_get Tags) (server off)"
    ;;

  set)
    need_cfg
    [[ -n "$2" && -n "$3" ]] || die "usage: hotcli set <name|maxplayers|public|voice|request|reboot> <value>"
    val="${*:3}"
    case "${2,,}" in
      name)       cfg_set Name "$val" ;;
      maxplayers) [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 1 )) || die "ERR int >= 1"; cfg_set MaxPlayers "$val" ;;
      public)     cfg_set Public "$(truthy "$val")" ;;
      voice)      cfg_set VoiceChat "$(truthy "$val")" ;;
      request)    cfg_set RequestToJoin "$(truthy "$val")" ;;
      reboot)     if [[ "${val,,}" == off ]]; then cfg_set RebootEnabled false
                  else [[ "$val" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]] || die "ERR format HH:MM (24h) or off"
                       cfg_set RebootTime "$val"; cfg_set RebootEnabled true; fi ;;
      *)          die "ERR unknown key" ;;
    esac
    echo "OK (restart HOTServer to apply)"
    ;;

  tag)
    need_cfg
    op="${2,,}"; tag="${3,,}"
    [[ ( "$op" == add || "$op" == remove ) && -n "$tag" ]] || die "usage: hotcli tag <add|remove> <tag>   (tags: ${TAGS// /,})"
    [[ " $TAGS " == *" $tag "* ]] || die "ERR unknown tag (tags: ${TAGS// /,})"
    new=""
    for t in $(cfg_get Tags | tr ',' ' ' | tr '[:upper:]' '[:lower:]'); do
      [[ "$t" == "$tag" ]] || new="$new,$t"
    done
    [[ "$op" == add ]] && new="$new,$tag"
    new="${new#,}"
    cfg_set Tags "$new"
    echo "OK tags=${new:-(none)} (applies on next start)"
    ;;

  status|players|reboot)
    die "HOTServer isn't running. Start it first: hotcli start"
    ;;

  *)
    die "ERR unknown command (try: hotcli help)"
    ;;
esac
