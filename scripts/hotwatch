#!/usr/bin/env bash
# Hotwatch: On-Together relaunch handler in case of a crash or scheduled reboot
# Requires Enabled = true in awe.hotserver.cfg. Start it in the background with: hotcli start hotwatch

GAME="${HOT_GAME:-$HOME/.local/share/Steam/steamapps/common/On-Together/On-Together}"
FLAG="$GAME/BepInEx/hotserver.stopped"   # written by `hotcli stop`, removed when the game starts
CHECK=30        # seconds between checks
GRACE=180       # Gives a grace period before we start watching
HANG_FAILS=2    # Failed health checks in a row (~1 min). Possibly hung, so we kill
export DISPLAY="${DISPLAY:-:1}"
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

log()            { echo "[$(date '+%F %T')] $*"; }
server_running() { pgrep -f 'OnTogether\.exe.*-batchmode' >/dev/null; }   # our headless instance
game_running()   { pgrep -f 'OnTogether\.exe' >/dev/null; }                # any instance, incl. normal play
booting()        { (( $(date +%s) - launched < GRACE )); }
launch()         { log "launching"; "$DIR/hotcli" start >/dev/null 2>&1; launched=$(date +%s); }

launched=0
fails=0
log "hotwatch started (game: $GAME)"

while true; do
  if [[ -f "$FLAG" ]]; then              # stopped on purpose
    sleep "$CHECK"; continue
  fi

  if ! server_running; then
    if game_running; then                # Someone manually ran the game so we assume theyre playing ig
      sleep "$CHECK"; continue
    fi
    booting || { log "game not running"; launch; }
    fails=0; sleep "$CHECK"; continue
  fi

  if ! booting; then
    if "$DIR/hotcli" status >/dev/null 2>&1; then
      fails=0
    else
      fails=$((fails + 1))
      if (( fails >= HANG_FAILS )); then
        log "unresponsive for ~$((HANG_FAILS * CHECK))s, killing"
        pkill -f 'OnTogether\.exe.*-batchmode'; fails=0; sleep 10
      fi
    fi
  fi
  sleep "$CHECK"
done
