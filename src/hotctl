#!/usr/bin/env bash
# hotctl <command...>   e.g. hotctl status | hotctl set name My Room | hotctl players | hotctl start
PORT="${HOTCTL_PORT:-27555}"
APPID=3707400

if ! exec 3<>"/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
  # Game isnt running. Only start works so I dont have to deal with some edge case ahh errors
  if [[ "$1" == "start" ]]; then
    DISPLAY="${DISPLAY:-:1}" steam -applaunch "$APPID" >/dev/null 2>&1 & disown
    echo "OK starting (takes ~1 min; check with: hotctl status)"
    exit 0
  fi
  echo "HOTServer not reachable on 127.0.0.1:$PORT (not running? try: hotctl start)" >&2
  exit 1
fi

printf '%s\n' "${*:-help}" >&3
while IFS= read -r -t 10 line <&3; do
  [[ "$line" == "." ]] && break
  printf '%s\n' "$line"
done
exec 3>&-
